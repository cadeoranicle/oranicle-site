window.SKU4Loader = (() => {
    const REGION = "NYNJCT";

    const LOCAL_BASE = `/canonical/regions/${REGION}/provider-cpt/v1`;
    const REMOTE_BASE =
        "https://pub-6dde7e3865604b0aa28903cdbc0f2627.r2.dev/canonical/regions/NYNJCT/v1/provider_cpt_publish";
    const R2_BASE =
        "https://pub-6dde7e3865604b0aa28903cdbc0f2627.r2.dev";
    let providerIndexCache = null;

    async function fetchJson(url) {
        const res = await fetch(url, { cache: "no-store" });
        if (!res.ok) {
            throw new Error(`Failed to load JSON: ${url}`);
        }
        return await res.json();
    }

    async function loadClusterCentroidsUmap() {
        return await fetchJson(`${LOCAL_BASE}/nynjct_cluster_centroids_umap.json`);
    }

    async function loadRegionCloud() {
        return await fetchJson(
            `${REMOTE_BASE}/nynjct_region_cloud_sample_50k.json`
        );
    }

    async function loadRegionCentroids() {
        return await fetchJson(`${LOCAL_BASE}/nynjct_region_centroids.json`);
    }

    async function loadProviderIndex() {
        if (providerIndexCache) return providerIndexCache;
        providerIndexCache = await fetchJson(`${REMOTE_BASE}/provider_index.json`);
        return providerIndexCache;
    }

    async function loadProviderGeometry(npi) {
        return await fetchJson(`${REMOTE_BASE}/provider_geometry/provider_cpt_geometry_${npi}.json`);
    }

    async function loadProviderMetrics(npi) {
        return await fetchJson(`${REMOTE_BASE}/provider_metrics/provider_cpt_metrics_${npi}.json`);
    }

    async function loadProviderBusinessMetrics(npi) {
        return await fetchJson(`${REMOTE_BASE}/provider_business_metrics/provider_cpt_business_metrics_${npi}.json`);
    }

    async function loadProviderProfile(npi) {
        return await fetchJson(`${REMOTE_BASE}/provider_profiles/provider_cpt_profile_${npi}.json`);
    }

    let intelligenceSampleCache = null;
    let intelligenceSampleMap = null;

    async function fetchJson(url) {
        const res = await fetch(url, { cache: "no-store" });
        if (!res.ok) {
            throw new Error(`Failed to fetch ${url}: ${res.status}`);
        }
        return res.json();
    }

    async function loadProviderIntelligenceSample() {
        if (intelligenceSampleCache) return intelligenceSampleCache;

        const url = "https://pub-6dde7e3865604b0aa28903cdbc0f2627.r2.dev/canonical/regions/NYNJCT/v1/provider_cpt_publish/provider_intelligence_metrics_sample_10.json";
        intelligenceSampleCache = await fetchJson(url);

        intelligenceSampleMap = {};
        for (const row of (intelligenceSampleCache.providers || [])) {
            intelligenceSampleMap[String(row.provider_npi)] = row;
        }

        return intelligenceSampleCache;
    }

    async function loadProviderPeerIntelligence(npi) {
        const url = "https://pub-6dde7e3865604b0aa28903cdbc0f2627.r2.dev/canonical/regions/NYNJCT/v1/provider_cpt_publish/provider_intelligence_metrics_sample_10.sku4_3_peer.json";

        const res = await fetch(url);
        if (!res.ok) {
            throw new Error(`Failed to load peer intelligence JSON: ${res.status}`);
        }

        const data = await res.json();
        const providers = Array.isArray(data?.providers) ? data.providers : [];

        return providers.find(p => String(p.provider_npi) === String(npi)) || null;
    }



    async function loadProviderIntelligence(npi) {
        await loadProviderIntelligenceSample();
        return intelligenceSampleMap?.[String(npi)] || null;
    }

    window.SKU4Loader = (() => {
        const REGION = "NYNJCT";

        const PATHS = {
            providerIndex: "/canonical/regions/NYNJCT/v1/provider_cpt_publish/provider_index.json",
            intelligenceSample: "/canonical/regions/NYNJCT/v1/provider_cpt_publish/provider_intelligence_metrics_sample_10.json"
        };

        let intelligenceCache = null;
        let intelligenceMap = null;

        async function fetchJson(url) {
            const res = await fetch(url, { cache: "no-store" });
            if (!res.ok) throw new Error(`Failed to fetch ${url}: ${res.status}`);
            return res.json();
        }

        async function loadIntelligenceSample() {
            if (intelligenceCache) return intelligenceCache;
            intelligenceCache = await fetchJson(PATHS.intelligenceSample);

            intelligenceMap = {};
            for (const row of (intelligenceCache.providers || [])) {
                intelligenceMap[String(row.provider_npi)] = row;
            }

            return intelligenceCache;
        }

        async function loadProviderIntelligence(npi) {
            await loadIntelligenceSample();
            return intelligenceMap?.[String(npi)] || null;
        }

        return {
            ...(window.SKU4Loader || {}),
            loadIntelligenceSample,
            loadProviderIntelligence
        };
    })();

    async function loadProvider(npi) {
        const [geometry, metrics, business, profile] = await Promise.all([
            loadProviderGeometry(npi),
            loadProviderMetrics(npi),
            loadProviderBusinessMetrics(npi),
            loadProviderProfile(npi)
        ]);

        return {
            provider_npi: String(npi),
            region: REGION,
            geometry,
            metrics,
            business,
            profile
        };
    }

    async function loadProviderPublish(npi) {
        const url = "https://pub-6dde7e3865604b0aa28903cdbc0f2627.r2.dev/canonical/regions/NYNJCT/v1/provider_cpt_publish/provider_intelligence_metrics_sample_10.publish.json";

        const res = await fetch(url);
        if (!res.ok) {
            throw new Error(`Failed to load publish JSON: ${res.status}`);
        }

        const data = await res.json();
        const providers = Array.isArray(data?.providers) ? data.providers : [];

        return providers.find(p => String(p.provider_npi) === String(npi)) || null;
    }

    async function loadProviderCptIntelligence(npi) {
        const cleanNpi = String(npi || "").replace(/\D/g, "");
        if (!cleanNpi) {
            throw new Error("Missing NPI for CPT intelligence load");
        }

        const url =
            `${R2_BASE}/canonical/regions/NYNJCT/v1/provider_cpt_publish/Provider_CPT_intelligence/provider_cpt_intelligence_${cleanNpi}.json`;

        console.log("Loading provider CPT intelligence:", url);

        const res = await fetch(url, { cache: "no-store" });

        if (!res.ok) {
            throw new Error(
                `Failed to load provider CPT intelligence for ${cleanNpi}: ${res.status}`
            );
        }

        return await res.json();
    }

    async function loadProviderCptOpportunityPublish(npi) {
        const url = "https://pub-6dde7e3865604b0aa28903cdbc0f2627.r2.dev/canonical/regions/NYNJCT/v1/provider_cpt_publish/provider_cpt_opportunity_sample_10.publish.json";
        const res = await fetch(url);
        const json = await res.json();
        const providers = Array.isArray(json?.providers) ? json.providers : [];
        return providers.find(p => String(p.provider_npi) === String(npi)) || null;
    }

    async function loadProviderCptOpportunityPublish(npi) {
        const url =
            "https://pub-6dde7e3865604b0aa28903cdbc0f2627.r2.dev/canonical/regions/NYNJCT/v1/provider_cpt_publish/provider_cpt_opportunity_sample_10.publish.json";

        const res = await fetch(url);
        if (!res.ok) {
            throw new Error(`Failed to load provider CPT opportunity publish: ${res.status}`);
        }

        const json = await res.json();
        const providers = Array.isArray(json?.providers) ? json.providers : [];

        return providers.find(
            p => String(p.provider_npi) === String(npi)
        ) || null;
    }

    return {
        REGION,
        loadClusterCentroidsUmap,
        loadRegionCentroids,
        loadRegionCloud,
        loadProviderIndex,
        loadProvider,
        loadProviderIntelligenceSample,
        loadProviderIntelligence,
        loadProviderPublish,
        loadProviderPeerIntelligence,
        loadProviderCptIntelligence,
        loadProviderCptOpportunityPublish
    };
})();

console.log("sku4-loader.js loaded");